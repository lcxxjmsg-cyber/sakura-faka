  function closeAssignModal() { (document.querySelector('#card-assign-modal') as any).classList.add('hidden'); }
  async function doAssign() {
    const ids = Array.from(document.querySelectorAll('.as-check:checked')).map((c: any) => Number(c.value));
    if (!ids.length) return alert('请勾选卡密');
    try {
      await request('/api/admin/cards', { method: 'POST', body: JSON.stringify({ action: 'assign', ids, product_id: editingId }) });
      alert(`已将 ${ids.length} 张卡密分配到「${editingId}」`);
      closeAssignModal(); loadProducts();
    } catch (e: any) { alert(e.message); }
  }

  // ============ 仪表盘 ============
