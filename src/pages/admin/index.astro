  async function saveSite() {
    const site_name = (document.querySelector('#set-site-name') as any).value.trim();
    const site_welcome = (document.querySelector('#set-site-welcome') as any).value.trim();
    try { await request('/api/admin/settings', { method: 'POST', body: JSON.stringify({ site_name, site_welcome }) }); alert('已保存站点信息'); loadSettings(); }
    catch (e: any) { alert(e.message); }
  }

  async function saveMail() {
    const mail_from = (document.querySelector('#set-mail-from') as any).value.trim();
    const mail_resend_key = (document.querySelector('#set-mail-key') as any).value.trim();
    if (!mail_from && !mail_resend_key) return alert('请填写发件人或 Resend API Key（留空将清空）');
    try { await request('/api/admin/settings', { method: 'POST', body: JSON.stringify({ mail_from, mail_resend_key }) }); alert('已保存邮件配置'); loadSettings(); }
    catch (e: any) { alert(e.message); }
  }

  async function saveSweepToggle() {
    const enabled = (document.querySelector('#set-autosweep') as any).checked;
    try { await request('/api/admin/settings', { method: 'POST', body: JSON.stringify({ auto_sweep_enabled: enabled }) }); alert(enabled ? '自动归集已开启（真实广播，请确保子地址有 TRX 能量费）' : '自动归集已关闭'); loadSettings(); }
    catch (e: any) { alert(e.message); }
  }

  async function changePassword() {
    const oldP = (document.querySelector('#set-old-pass') as any).value;
    const newP = (document.querySelector('#set-new-pass') as any).value;
    const newP2 = (document.querySelector('#set-new-pass2') as any).value;
    if (!oldP) return alert('请输入当前密码');
    if (newP.length < 8) return alert('新密码至少 8 位');
    if (newP !== newP2) return alert('两次新密码不一致');
    try {
      await request('/api/admin/settings', { method: 'POST', body: JSON.stringify({ old_password: oldP, new_password: newP }) });
      alert('✅ 已修改密码，下次请用新密码登录');
      (document.querySelector('#set-old-pass') as any).value = '';
      (document.querySelector('#set-new-pass') as any).value = '';
      (document.querySelector('#set-new-pass2') as any).value = '';
      loadSettings();
    } catch (e: any) { alert(e.message); }
  }

  // ============ 卡密库存 ============
  let cardProducts: any[] = [];
  const cardProductLabel = (c: any) => (Number(c.product_id) > 0 ? (c.product_title || ('商品#' + c.product_id)) : '未分配(库)');

  async function loadCards() {
    await fillCardProducts();
    const list = document.querySelector('#cards-list') as HTMLElement;
    try {
      const q = (document.querySelector('#cards-q') as any).value.trim();
      const productId = (document.querySelector('#cards-product') as any).value;
      const status = (document.querySelector('#cards-status') as any).value;
      const url = `/api/admin/cards?limit=300&q=${encodeURIComponent(q)}&status=${status}` + (productId !== '' ? `&product_id=${productId}` : '');
      const data = await request(url);
      const rows = data.data || [];
      list.innerHTML = rows.length ? rows.map((c: any) => {
        const assignSel = `<select class="input !w-32 !py-1 !px-2 text-xs assignsel" data-id="${c.id}"><option value="">→商品</option></select><button onclick="assignCard(${c.id})" class="btn-ghost !py-1 !px-2 text-xs">分配</button>`;
        const ops = (c.status === 0)
          ? `<button onclick="editCard(${c.id})" class="btn-ghost !py-1 !px-2 text-xs">编辑</button>${assignSel}${Number(c.product_id) > 0 ? `<button onclick="releaseCard(${c.id})" class="btn-ghost !py-1 !px-2 text-xs">回库</button>` : ''}<button onclick="deleteCard(${c.id})" class="btn-ghost !py-1 !px-2 text-xs !text-rose-500">删除</button>`
          : '<span class="text-xs text-muted">已售不可改</span>';
        return `<div class="card px-4 py-2.5 flex flex-wrap items-center gap-3">
          <code class="text-xs text-slate-400">#${c.id}</code>
          <span class="badge ${c.status === 1 ? 'badge-success' : ''}">${c.status === 1 ? '已售' : '未售'}</span>
          <span class="badge badge-primary">${esc(cardProductLabel(c))}</span>
          <code class="text-sm font-mono break-all flex-1">${esc(c.card)}</code>
          <span class="text-xs text-muted">${c.status === 1 ? '订单 ' + esc(String(c.order_id || '').slice(0, 10)) : ''}</span>
          <div class="flex flex-wrap gap-1">${ops}</div>
        </div>`;
      }).join('') : '<div class="text-center text-slate-400 py-12">暂无卡密</div>';
      document.querySelectorAll('.assignsel').forEach((sel: any) => fillAssignOptions(sel));
    } catch (e: any) { list.innerHTML = '<div class="text-rose-500">加载失败</div>'; }
  }

  function fillAssignOptions(sel: HTMLSelectElement) {
    if (sel.options.length > 1) return;
    cardProducts.forEach((p) => { const o = document.createElement('option'); o.value = p.id; o.textContent = p.title; sel.appendChild(o); });
  }

  async function fillCardProducts() {
    try {
      const d = await request('/api/admin/products');
      cardProducts = d.data || [];
      const rebuild = (selId: string, libLabel: string, addAll: boolean) => {
        const sel = document.querySelector(selId) as HTMLSelectElement;
        if (!sel) return;
        let html = addAll ? '<option value="">全部</option>' : '';
        if (libLabel) html += `<option value="0">${libLabel}</option>`;
        sel.innerHTML = html;
        cardProducts.forEach((p) => { const o = document.createElement('option'); o.value = p.id; o.textContent = p.title; sel.appendChild(o); });
      };
      rebuild('#cards-product', '未分配(库)', true);
      rebuild('#cc-product', '卡密库（暂不分配）', false);
      rebuild('#ci-product', '卡密库（暂不分配）', false);
    } catch { /* 忽略 */ }
  }

  async function openCardCreate() { await fillCardProducts(); (document.querySelector('#card-create-modal') as any).classList.remove('hidden'); (document.querySelector('#cc-msg') as any).textContent = ''; }
  function closeCardCreate() { (document.querySelector('#card-create-modal') as any).classList.add('hidden'); }
  async function openCardImport() { await fillCardProducts(); (document.querySelector('#card-import-modal') as any).classList.remove('hidden'); (document.querySelector('#ci-msg') as any).textContent = ''; }
  function closeCardImport() { (document.querySelector('#card-import-modal') as any).classList.add('hidden'); }

  async function createCard() {
    const card = (document.querySelector('#cc-text') as any).value.trim();
    if (!card) return alert('卡密内容为空');
    const product_id = Number((document.querySelector('#cc-product') as any).value || 0);
    try { await request('/api/admin/cards', { method: 'POST', body: JSON.stringify({ action: 'create', card, product_id }) }); (document.querySelector('#cc-msg') as any).textContent = '✅ 已创建'; closeCardCreate(); loadCards(); }
    catch (e: any) { (document.querySelector('#cc-msg') as any).textContent = e.message; }
  }

  async function cardImport() {
    const text = (document.querySelector('#ci-text') as any).value;
    const product_id = Number((document.querySelector('#ci-product') as any).value || 0);
    if (!text.trim()) return alert('卡密内容为空');
    try {
      const data = await request('/api/admin/cards', { method: 'POST', body: JSON.stringify({ action: 'import', text, product_id }) });
      (document.querySelector('#ci-msg') as any).textContent = `✅ 成功导入 ${data.data.count} 条${data.data.skipped ? '，跳过重复 ' + data.data.skipped : ''}`;
      setTimeout(closeCardImport, 1000); loadCards();
    } catch (e: any) { (document.querySelector('#ci-msg') as any).textContent = e.message; }
  }

  async function editCard(id: number) {
    const v = prompt('修改卡密内容（留空则取消）');
    if (v === null) return;
    const card = v.trim(); if (!card) return;
    try { await request('/api/admin/cards', { method: 'POST', body: JSON.stringify({ action: 'update', id, card }) }); loadCards(); }
    catch (e: any) { alert(e.message); }
  }

  async function assignCard(id: number) {
    const product_id = Number((document.querySelector(`.assignsel[data-id="${id}"]`) as any)?.value || 0);
    if (!product_id) return alert('请先选择目标商品');
    try { await request('/api/admin/cards', { method: 'POST', body: JSON.stringify({ action: 'assign', ids: [id], product_id }) }); loadCards(); }
    catch (e: any) { alert(e.message); }
  }

  async function releaseCard(id: number) {
    if (!confirm('确认将该卡密移回卡密库（未分配）？')) return;
    try { await request('/api/admin/cards', { method: 'POST', body: JSON.stringify({ action: 'release', id }) }); loadCards(); }
    catch (e: any) { alert(e.message); }
  }

  async function deleteCard(id: number) {
    if (!confirm('确认删除该卡密？')) return;
    try { await request('/api/admin/cards', { method: 'POST', body: JSON.stringify({ action: 'delete', id }) }); loadCards(); }
    catch (e: any) { alert(e.message); }
  }

  // 从卡密库分配未分配卡密到当前编辑的商品
  async function openAssignModal() {
    if (!editingId) return alert('请先保存商品再选择卡密');
    const sel = document.querySelector('#as-list') as HTMLElement;
    sel.innerHTML = '加载中…';
    (document.querySelector('#card-assign-modal') as any).classList.remove('hidden');
    try {
      const d = await request('/api/admin/cards?product_id=0&status=0&limit=300');
      const rows = d.data || [];
      sel.innerHTML = rows.length
        ? rows.map((c: any) => `<label class="flex items-start gap-2 py-1.5"><input type="checkbox" class="as-check" value="${c.id}" /><code class="text-xs font-mono break-all flex-1">${esc(c.card)}</code></label>`).join('')
        : '<div class="text-center text-muted py-6">卡密库没有可用卡密，请先创建/导入</div>';
    } catch (e: any) { sel.textContent = '加载失败'; }
