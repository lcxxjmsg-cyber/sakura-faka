---
import Layout from '@/layouts/Layout.astro';
import { getProduct } from '@/lib/db';
import BuyPanel from '@/components/BuyPanel.astro';

export const prerender = false;
const runtime = (Astro as any).locals?.runtime;
const env = runtime?.env;
const id = Number(Astro.params.id);
const loadedProduct = env ? await getProduct(env.DB, id) : null;
const product = loadedProduct?.status === 1 ? loadedProduct : null;
---
<Layout title={product?.title || '商品'}>
  {
    !product ? (
      <div class="text-center py-24">
        <h1 class="text-2xl font-bold t-title">商品不存在或已下架</h1>
        <a href="/" class="btn-primary mt-6">返回商店</a>
      </div>
    ) : (
      <div class="grid lg:grid-cols-5 gap-8 items-start">
        <div class="lg:col-span-3 space-y-6">
          <div class="card overflow-hidden">
            <div class="aspect-[4/3] bg-[var(--bg-subtle)] grid place-items-center overflow-hidden">
              {product.cover ? (
                <img src={product.cover} alt={product.title} class="w-full h-full object-cover" />
              ) : (
                <span class="text-5xl opacity-40" style="color: var(--muted)">🛍</span>
              )}
            </div>
          </div>

          <div class="card p-6">
            <div class="flex items-center gap-2 mb-3">
              {product.category && <span class="badge badge-primary">{product.category}</span>}
              <span class="badge">{product.delivery_type === 'manual' ? '人工处理' : product.delivery_type === 'json' ? 'JSON资源' : '自动发货'}</span>
            </div>
            <h1 class="text-2xl md:text-3xl font-extrabold t-title">{product.title}</h1>
            {product.description && (
              <div class="mt-4 text-[15px] leading-7 text-muted prose" set:html={product.description} />
            )}
          </div>
        </div>

        <div class="lg:col-span-2 lg:sticky lg:top-20 space-y-4">
          <BuyPanel
            id={product.id}
            title={product.title}
            desc={product.description}
            price={product.price}
            stock={product.stock}
            deliveryType={product.delivery_type || 'text'}
          />
          <div class="card p-4 text-xs leading-6 text-muted">
            <p class="font-semibold t-title mb-2">为什么安全</p>
            <ul class="space-y-1">
              <li>每笔订单独立收款地址</li>
              <li>USDT (TRC-20) · 链上自动确认</li>
              <li>确认后立即自动发货</li>
              <li>无需注册，收货码即凭证</li>
            </ul>
          </div>
        </div>
      </div>
    )
  }
</Layout>

<style is:global>
  .prose p { margin: 0.4rem 0; }
  .prose code { background: var(--bg-subtle); padding: 2px 6px; border-radius: 4px; }
</style>
