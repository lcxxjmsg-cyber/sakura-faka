---
import { formatUsdt } from '@/lib/db';

interface Props { id: number; title: string; cover: string; price: string; desc: string; category: string; stock: number; sold: number; deliveryType?: string; }
const { id, title, cover, price, desc, category, stock, sold, deliveryType = 'text' } = Astro.props;
const fmtPrice = formatUsdt(price);
const shortDesc = desc.replace(/<[^>]+>/g, '').trim().slice(0, 70);
const deliveryLabel = deliveryType === 'manual' ? '人工处理' : deliveryType === 'json' ? 'JSON资源' : '自动发货';
---
<a href={`/product/${id}`} class="card card-hover overflow-hidden block">
  <div class="aspect-[4/3] bg-[var(--bg-subtle)] overflow-hidden grid place-items-center">
    {cover ? (
      <img src={cover} alt={title} class="w-full h-full object-cover" />
    ) : (
      <span class="text-4xl opacity-40" style="color: var(--muted)">🛍</span>
    )}
  </div>
  <div class="p-4 space-y-2">
    <div class="flex items-center justify-between">
      {category && <span class="badge badge-primary">{category}</span>}
      <span class="badge">{deliveryLabel}</span>
    </div>
    <h3 class="font-semibold line-clamp-1 t-title">{title}</h3>
    {shortDesc && <p class="text-sm text-muted line-clamp-2">{shortDesc}</p>}
    <div class="flex items-center justify-between pt-1">
      <span class="font-bold" style="color: var(--primary)">{fmtPrice} <span class="text-xs font-normal text-muted">USDT</span></span>
      <span class="text-xs" style="color: var(--muted)">{stock > 0 ? `库存 ${stock}` : '已售罄'}</span>
    </div>
    <div class="pt-2">
      <span class="btn-primary w-full !py-2.5 text-sm" style={stock > 0 ? '' : 'background: var(--muted); box-shadow:none;'}>立即购买</span>
    </div>
  </div>
</a>
