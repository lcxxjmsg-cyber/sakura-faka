---
import { formatUsdt } from '@/lib/db';

interface Props {
  id: number;
  title: string;
  desc: string;
  price: string;
  stock: number;
  deliveryType?: 'text' | 'json' | 'manual';
}
const { id, title, desc, price, stock, deliveryType = 'text' } = Astro.props;
const fmtPrice = formatUsdt(price);
---
<div class="card p-6 md:p-8">
  <span class="badge bg-rose-50 text-rose-500 border border-rose-200">USDT · TRC-20</span>
  <h1 class="mt-4 text-2xl md:text-3xl font-bold text-slate-800">{title}</h1>
  {desc && <div class="mt-3 text-sm text-slate-600 leading-relaxed prose text-slate-600">{desc}</div>}

  <div class="mt-6 p-4 rounded-xl bg-white border border-slate-100">
    <label class="text-sm text-slate-500">购买数量</label>
    <div class="mt-2 flex items-center gap-3">
      <button type="button" id="minus" class="w-10 h-10 rounded-lg border border-slate-200 hover:bg-rose-50 hover:border-rose-300 transition text-xl font-bold text-slate-600">−</button>
      <input id="qty" type="number" min="1" max="10" value="1" class="input text-center !w-20" />
      <button type="button" id="plus" class="w-10 h-10 rounded-lg border border-slate-200 hover:bg-rose-50 hover:border-rose-300 transition text-xl font-bold text-slate-600">＋</button>
    </div>
    <div class="mt-4 flex items-center justify-between text-sm">
      <span class="text-slate-500">应付金额</span>
      <span class="text-xl font-bold text-rose-500" id="total">{fmtPrice} <small class="text-xs font-normal text-slate-400">USDT</small></span>
    </div>
  </div>

  <label class="mt-4 block text-sm text-slate-500">邮箱（可选，接收卡密通知）</label>
  <input id="email" type="email" class="input mt-2" placeholder="you@example.com" />

  <button id="buy" class="btn-sakura w-full mt-6 text-lg" disabled={stock <= 0}>
    {stock > 0 ? '立即购买' : '已售罄'}
  </button>
  <p id="tip" class="mt-3 text-center text-sm text-slate-500"></p>

  <!-- 支付面板（隐藏，下单后显示） -->
  <div id="pay-panel" class="hidden mt-6">
    <div class="rounded-xl bg-white border border-rose-200 p-4">
      <div class="flex items-center gap-2 text-rose-500 font-semibold">
        <svg class="w-5 h-5 animate-pulse" fill="currentColor" viewBox="0 0 24 24"><path d="M12 22C6.5 22 2 17.5 2 12S6.5 2 12 2s10 4.5 10 10-4.5 10-10 10zm-1-13v4l3 3 1-1-2.5-2.5V9h-1.5z"/></svg>
        请使用 USDT (TRC-20) 转账到以下地址
      </div>
      <div id="addr-box" class="mt-3 flex items-center gap-2">
        <code id="pay-addr" class="text-sm break-all text-slate-700 select-all flex-1"></code>
        <button id="copy-addr" class="btn-ghost !px-3 !py-2 text-xs shrink-0">复制</button>
      </div>
      <div class="mt-3 text-sm text-slate-500">
        金额：<b class="text-rose-500" id="pay-amount"></b> USDT · 订单号：<code id="order-id" class="text-xs"></code>
      </div>
      <div class="mt-2">
        <span class="badge bg-amber-50 text-amber-600 border border-amber-200">⏳ 等待支付确认，最多 <span id="countdown">30:00</span></span>
      </div>
    </div>

    <!-- 发货展示区 -->
    <div id="deliver" class="hidden mt-4 rounded-xl bg-emerald-50 border border-emerald-200 p-4">
      <div class="flex items-center gap-2 text-emerald-600 font-semibold">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7l-1.5-1.5L9 14l-2.5-2.5L5 13z"/></svg>
        {deliveryType === 'json' ? '购买成功！您的资源配置：' : deliveryType === 'manual' ? '订单已支付，请等待人工处理：' : '购买成功！您的资源：'}
      </div>
      <div id="cards-area" class="mt-3 space-y-2"></div>
    </div>
  </div>
</div>

<style is:global>
  .prose p { margin: 0.4rem 0; }
  .prose code { background: rgba(244, 63, 94, 0.08); color: #be123c; padding: 2px 6px; border-radius: 4px; }
</style>

<script is:inline define:vars={{ id, price, deliveryType }}>
  const pid = id;
  const priceMin = BigInt(price);

  const $ = (s) => document.querySelector(s);
  const buyBtn = $('#buy');
  const qtyEl = $('#qty');
  const totalEl = $('#total');
  const tipEl = $('#tip');
  const payPanel = $('#pay-panel');
  const payAddr = $('#pay-addr');
  const payAmount = $('#pay-amount');
  const orderIdEl = $('#order-id');
  const deliverEl = $('#deliver');
  const cardsArea = $('#cards-area');
  const countdownEl = $('#countdown');
  const emailEl = $('#email');

  const mult = 1000000n;
  let qty = 1;
  let pollTimer = null;
  let countdownTimer = null;
  let orderId = '';
  let viewToken = '';

  function fmtFull(minUnit) { return (Number(minUnit) / Number(mult)).toString(); }
  function updateTotal() {
    totalEl.textContent = `${fmtFull((priceMin * BigInt(qty)).toString())} USDT`;
  }
  $('#minus').onclick = () => { qty = Math.max(1, qty - 1); qtyEl.value = qty; updateTotal(); };
  $('#plus').onclick = () => { qty = Math.min(10, qty + 1); qtyEl.value = qty; updateTotal(); };
  qtyEl.oninput = () => { qty = Math.min(10, Math.max(1, parseInt(qtyEl.value) || 1)); qtyEl.value = qty; updateTotal(); };

  $('#copy-addr').onclick = async () => {
    try {
      await navigator.clipboard.writeText(payAddr.textContent);
      tipEl.textContent = '✅ 地址已复制';
    } catch { tipEl.textContent = '复制失败，请手动复制'; }
  };

  buyBtn.onclick = async () => {
    if (qty < 1) return;
    buyBtn.disabled = true;
    tipEl.textContent = '正在创建订单…';
    try {
      const res = await fetch('/api/order/create', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ product_id: pid, qty, email: emailEl.value }),
      });
      const data = await res.json();
      if (!data.ok) { tipEl.textContent = data.error || '下单失败'; buyBtn.disabled = false; return; }
      orderId = data.data.id;
      viewToken = data.data.view_token || '';
      localStorage.setItem('faka:last-order', JSON.stringify({ id: orderId, token: viewToken }));
      showPayPanel(data.data);
      startPolling();
      startCountdown();
      tipEl.textContent = '';
    } catch { tipEl.textContent = '网络错误，请重试'; buyBtn.disabled = false; }
  };

  function showPayPanel(order) {
    payPanel.classList.remove('hidden');
    payAddr.textContent = order.address;
    payAmount.textContent = fmtFull(order.total_price);
    orderIdEl.textContent = order.id;
    deliverEl.classList.add('hidden');
    buyBtn.textContent = '等待支付…';
    buyBtn.disabled = true;
    let actions = document.querySelector('#order-actions');
    if (!actions) {
      actions = document.createElement('div');
      actions.id = 'order-actions';
      actions.className = 'mt-3 flex gap-2';
      actions.innerHTML = '<button id="check-payment" class="btn-sakura flex-1 !py-2 text-sm">我已支付，立即检测</button><button id="cancel-order" class="btn-ghost !py-2 text-sm">取消订单</button>';
      payPanel.appendChild(actions);
      document.querySelector('#check-payment').onclick = checkNow;
      document.querySelector('#cancel-order').onclick = cancelCurrent;
    }
  }

  async function checkNow() {
    const button = document.querySelector('#check-payment');
    button.disabled = true;
    tipEl.textContent = '正在检测链上支付…';
    try {
      const res = await fetch('/api/order/check', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ order_id: orderId, view_token: viewToken }) });
      const data = await res.json();
      if (!data.ok) { tipEl.textContent = data.error || '检测失败'; return; }
      if (data.data.status === 'shipped') { showCards({ id: orderId }); clearPolling(); }
      else if (data.data.status === 'paid') tipEl.textContent = `已检测到支付，确认数 ${data.data.confirmations || 0}，请稍候`;
      else if (data.data.status === 'closed') tipEl.textContent = '订单已关闭';
      else tipEl.textContent = '暂未检测到足额支付，请确认网络和金额';
    } catch { tipEl.textContent = '检测失败，请稍后重试'; }
    finally { button.disabled = false; }
  }

  async function cancelCurrent() {
    if (!confirm('确定取消这个未支付订单吗？')) return;
    const res = await fetch('/api/order/cancel', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ order_id: orderId, view_token: viewToken }) });
    const data = await res.json();
    if (data.ok) { localStorage.removeItem('faka:last-order'); clearPolling(); payPanel.classList.add('hidden'); buyBtn.textContent = '重新下单'; buyBtn.disabled = false; tipEl.textContent = '订单已取消'; }
    else tipEl.textContent = data.error || '取消失败';
  }

  async function resumeOrder() {
    try {
      const saved = JSON.parse(localStorage.getItem('faka:last-order') || 'null');
      if (!saved?.id || !saved?.token) return;
      const res = await fetch(`/api/order/query?id=${encodeURIComponent(saved.id)}`);
      const data = await res.json();
      if (!data.ok || data.data.status === 'closed') { localStorage.removeItem('faka:last-order'); return; }
      orderId = saved.id; viewToken = saved.token; showPayPanel(data.data); startPolling(); startCountdown();
      if (data.data.status === 'shipped') { showCards(data.data); clearPolling(); }
    } catch {}
  }

  function startCountdown() {
    let sec = 30 * 60;
    clearInterval(countdownTimer);
    countdownTimer = setInterval(() => {
      sec--;
      const m = String(Math.floor(sec / 60)).padStart(2, '0');
      const s = String(sec % 60).padStart(2, '0');
      countdownEl.textContent = `${m}:${s}`;
      if (sec <= 0) {
        clearInterval(countdownTimer);
        clearInterval(pollTimer);
        tipEl.textContent = '订单已超时，可重新下单';
        buyBtn.textContent = '重新下单';
        buyBtn.disabled = false;
        payPanel.classList.add('hidden');
      }
    }, 1000);
  }

  function startPolling() {
    clearInterval(pollTimer);
    pollTimer = setInterval(async () => {
      try {
        const res = await fetch(`/api/order/query?id=${orderId}`);
        const data = await res.json();
        if (!data.ok) return;
        const o = data.data;
        if (o.status === 'shipped') { showCards(o); clearPolling(); }
        else if (o.status === 'paid') { tipEl.textContent = '已支付，确认中…'; }
        else if (o.status === 'closed') {
          clearPolling();
          tipEl.textContent = '订单已关闭，请重新下单';
          buyBtn.textContent = '重新下单';
          buyBtn.disabled = false;
          payPanel.classList.add('hidden');
        }
      } catch {}
    }, 5000);
  }

  function clearPolling() { clearInterval(pollTimer); clearInterval(countdownTimer); }

  async function showCards(o) {
    deliverEl.classList.remove('hidden');
    cardsArea.innerHTML = '';
    tipEl.textContent = '';
    buyBtn.textContent = '已完成';
    buyBtn.disabled = true;
    try {
      const res = await fetch(`/api/order/view?id=${o.id}&token=${viewToken}`);
      const data = await res.json();
      if (data.ok && Array.isArray(data.data)) {
        data.data.forEach((c) => {
          const d = document.createElement('div');
          d.className = 'p-2.5 rounded-lg bg-white border border-emerald-200 font-mono text-sm text-slate-700 break-all';
          if (deliveryType === 'json') {
            try { d.textContent = JSON.stringify(JSON.parse(c), null, 2); }
            catch { d.textContent = c; }
          } else d.textContent = c;
          cardsArea.appendChild(d);
        });
      }
    } catch {}
  }

  updateTotal();
  resumeOrder();
</script>
