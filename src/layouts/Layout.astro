---
import '../styles/global.css';
import { getSiteConfig } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = '二次元自助服务商店，USDT 支付，即时发货' } = Astro.props;
const site = await getSiteConfig((Astro as any).locals?.runtime);
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · 二次元自助商店`;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7d4e0" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌸</text></svg>" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="sticky top-0 z-40 glass">
      <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group">
          <span class="text-2xl">🌸</span>
          <span class="text-lg font-bold text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-pink-500">{site.name}</span>
        </a>
        <div class="flex items-center gap-4 text-sm font-medium">
          <a href="/" class={path === '/' ? 'text-rose-500' : 'text-slate-600 hover:text-rose-500 transition'}>商店</a>
          <a href="/admin" class="text-slate-600 hover:text-rose-500 transition">管理</a>
        </div>
      </nav>
    </header>

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="mt-12">
      <div class="max-w-6xl mx-auto px-4 py-8 text-center text-sm text-slate-500">
        <p>🌸 {site.welcome}</p>
        <p class="mt-2">本站支持 USDT (TRC-20) 支付 · 自动发货</p>
      </div>
    </footer>
  </body>
</html>
