---
import '../styles/global.css';
import { getSiteConfig } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
  showFooter?: boolean;
}
const { title, description = '即时交付数字商品 · USDT 自动发货', showFooter = true } = Astro.props;
const site = await getSiteConfig((Astro as any).locals?.runtime);
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · 即时交付数字商品`;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '商品列表', active: path === '/' },
  { href: '/track', label: '订单查询', active: path.startsWith('/track') },
];
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e11d48" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌸</text></svg>" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="sticky top-0 z-40 backdrop-blur bg-[var(--bg)]/80 border-b" style="border-color: var(--border)">
      <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-lg grid place-items-center text-white font-bold text-sm" style="background: var(--primary)">S</span>
          <span class="font-bold text-lg" style="color: var(--text)">{site.name}</span>
        </a>
        <div class="flex items-center gap-5 text-sm font-medium">
          {nav.map((n) => (
            <a href={n.href} class="transition" style={n.active ? 'color: var(--primary)' : 'color: var(--muted)'}>{n.label}</a>
          ))}
          <button id="theme-toggle" type="button" class="w-9 h-9 rounded-full grid place-items-center border" style="border-color: var(--border); color: var(--text)" title="切换主题">
            <svg id="moon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
            <svg id="sun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </div>
      </nav>
    </header>

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>

    {showFooter && (
      <footer class="mt-16 border-t" style="border-color: var(--border)">
        <div class="max-w-6xl mx-auto px-4 py-10 text-center space-y-2">
          <p class="font-semibold" style="color: var(--text)">{site.name}</p>
          <p class="text-sm" style="color: var(--muted)">{site.welcome}</p>
          <p class="text-xs" style="color: var(--muted)">支持 USDT (TRC-20) · 链上自动确认 · 支付完成自动发货 · 无需注册</p>
        </div>
      </footer>
    )}

    <script>
      const root = document.documentElement;
      const moon = document.getElementById('moon');
      const sun = document.getElementById('sun');
      const apply = (t: 'light' | 'dark') => {
        root.setAttribute('data-theme', t);
        localStorage.setItem('sf-theme', t);
        moon?.classList.toggle('hidden', t === 'dark');
        sun?.classList.toggle('hidden', t === 'light');
      };
      const saved = localStorage.getItem('sf-theme');
      if (saved === 'dark') apply('dark');
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        apply(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      });
    </script>
  </body>
</html>
