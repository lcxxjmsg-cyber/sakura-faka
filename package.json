{
  "name": "faka-store",
  "type": "module",
  "version": "1.0.0",
  "description": "二次元风格 Cryptocurrency 自助发卡系统 - USTD(TRC-20) 收款",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "db:init": "wrangler d1 execute faka-db --file=./schema.sql --remote",
    "db:local": "wrangler d1 execute faka-db --file=./schema.sql --local",
    "deploy": "wrangler deploy",
    "seed": "wrangler d1 execute faka-db --file=./seed.sql --local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.5.0",
    "@hono/node-server": "^1.13.8",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "astro": "^5.6.0",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/tailwind": "^5.1.5",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.13.13",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "workerd@1.20260828.1": true
  }
}
